# --- DevPilot production config (Oracle VM / any Docker host) ---
# Copy to .env and fill in:  cp .env.example .env

# Public hostname of the site (no scheme). With no domain yet you can use
# nip.io:  devpilot.<YOUR-VM-PUBLIC-IP>.nip.io
DOMAIN=devpilot.example.com

# GitHub OAuth App (github.com/settings/developers -> OAuth Apps -> New).
# Homepage URL: Concord,Authorization callback URL: https://${DOMAIN}/login/oauth2/code/github
# NOTE: for local dev the callback is http://localhost:8080/login/oauth2/code/github,
# so most people register TWO OAuth Apps (one local, one production).
GITHUB_CLIENT_ID=paste your production client id here (starts with Ov1...)
GITHUB_CLIENT_SECRET=paste your production client secret here

# Database (change the password)
POSTGRES_DB=devpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password

# Encrypts GitHub tokens + users' OpenAI keys at rest. Generate once and keep secret:
#   openssl rand -hex 32   (password, 64 hex chars)
#   openssl rand -hex 8    (salt, 16 hex chars)
TOKEN_ENCRYPTOR_PASSWORD=paste-64-hex-chars-here
TOKEN_ENCRYPTOR_SALT=paste-16-hex-chars-here

# Optional. Server-wide OpenAI key (unused in normal BYOK operation;
# every user adds their own key in Settings). Only needed as a fallback.
# OPENAI_API_KEY=sk-...
