# --- DevPilot production config (Oracle VM / any Docker host) ---
# Copy to .env and fill in:  cp .env.example .env   (.env is never committed)

# Public hostname of the site (no scheme). With no domain yet you can use
# nip.io:  devpilot.<YOUR-VM-PUBLIC-IP>.nip.io
DOMAIN=devpilot.example.com

# Database (change the password)
POSTGRES_DB=devpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password

# One AI key for the whole site. Free at https://aistudio.google.com/apikey
# Visitors never paste a key.
GEMINI_API_KEY=

# Optional: a classic GitHub token with no scopes (60 -> 5,000 API calls an hour).
GITHUB_TOKEN=

# Daily free limits, per visitor (0 = off).
LIMIT_QUESTIONS_PER_VISITOR=30
LIMIT_INDEXES_PER_VISITOR=5

# Optional: answer with an OpenCode Zen model instead (embeddings stay on Gemini).
# AI_PROVIDER=opencode
# OPENCODE_API_KEY=
# OPENCODE_MODEL=longcat-2.5-preview-free
